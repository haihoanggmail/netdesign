  "type": "module",
  "scripts": {
    "build:viewer3d": "node scripts/build-viewer3d.mjs",
    "predev": "npm run build:viewer3d",
    "dev": "tsx server.ts",
    "predev:vite": "npm run build:viewer3d",
    "dev:vite": "vite --port 3000",
    "start": "node server.ts",
    "prebuild": "npm run build:viewer3d",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pretest": "npm run build:viewer3d",
    "test": "tsx src/utils/__tests__/runTests.ts && tsx src/utils/__tests__/viewportMath.test.ts && tsx src/utils/__tests__/selectionBounds.test.ts && tsx src/utils/__tests__/v24.test.ts && tsx src/utils/__tests__/v25.test.ts && tsx src/utils/__tests__/viewer3dHtml.test.ts && tsx src/utils/__tests__/viewer3dRuntime.test.ts && tsx src/utils/__tests__/viewer3dBundle.test.ts && tsx src/utils/__tests__/sceneBudget.test.ts && tsx src/utils/__tests__/sceneSerialize.test.ts",
    "bench": "tsx src/utils/__tests__/perf.bench.ts",
    "bench:enforce": "tsx src/utils/__tests__/perf.bench.ts --enforce --json=test-results/bench.json",
    "pretest:e2e": "npm run build:viewer3d",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:parity": "tsx src/utils/__tests__/renderParity.chromium.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
