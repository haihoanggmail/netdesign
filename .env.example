# Biến môi trường tùy chọn cho HACHIHI Network & Electrical Designer
# Lưu ý: Ứng dụng chạy hoàn toàn trong trình duyệt (IndexedDB/PWA) ngay cả khi không đặt biến nào.

# Khóa API Gemini phía máy chủ / Serverless (chỉ cần nếu bật Trợ lý AI trực tuyến)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cổng chạy Express server (tùy chọn, mặc định 3000)
# PORT="3000"

# URL công khai của ứng dụng (tùy chọn, dùng kiểm tra Origin cho API)
APP_URL="http://localhost:3000"

# Danh sách domain bổ sung được phép nhúng iframe qua CSP frame-ancestors (phân cách bằng dấu phẩy, tùy chọn)
# ALLOWED_FRAME_ANCESTORS="https://hachihi.vn https://*.hachihi.vn"

# Khóa bảo vệ tùy chọn cho endpoint /api/gemini/chat (đặt nếu muốn giới hạn truy cập)
# CHAT_API_SECRET=""

# Giới hạn tần suất /api/gemini/chat theo IP và tổng lượt/ngày toàn hệ thống
# CHAT_RATE_LIMIT_PER_MIN="15"
# CHAT_RATE_LIMIT_PER_HOUR="60"
# CHAT_DAILY_LIMIT="500"

# Kho Redis dùng chung qua Upstash REST cho Serverless/Multi-instance rate limit (tùy chọn)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Tên mô hình (tùy chọn). Mặc định: chế độ sâu = gemini-4-hydrogen, chế độ nhanh = gemini-3.1-flash-lite
# GEMINI_MODEL="gemini-4-hydrogen"
# GEMINI_MODEL_FAST="gemini-3.1-flash-lite"

# Biểu mẫu Góp ý Google Form (tùy chọn - khi để trống nút Góp ý sẽ tự ẩn)
# VITE_FEEDBACK_FORM_URL="https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform"
# VITE_FEEDBACK_ENTRY_VERSION="entry.111111111"
# VITE_FEEDBACK_ENTRY_BUILD="entry.222222222"
# VITE_FEEDBACK_ENTRY_MODE="entry.333333333"
# VITE_FEEDBACK_ENTRY_DEVICE="entry.444444444"

# Ghi log truy cập / lấy mẫu / lưu / xuất về Google Sheet (tùy chọn — thiếu một trong hai thì tự bỏ qua)
# URL_SHEET: URL Web App của Google Apps Script (https://script.google.com/macros/s/.../exec)
# SERECT_SHEET: chuỗi bí mật, phải trùng với Script property SERECT_SHEET trong Apps Script
# URL_SHEET=""
# SERECT_SHEET=""
